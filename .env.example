# Server-side only — do NOT use VITE_ prefixes (those get shipped to the browser).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Must match a Redirect URI in the Spotify Developer Dashboard.
# Local auth script default:
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:4371/callback
# Production:
# SPOTIFY_REDIRECT_URI=https://vaibhavsharma.me/api/spotify-callback

# Optional track id used when refresh fails
# SPOTIFY_FALLBACK_TRACK_ID=
